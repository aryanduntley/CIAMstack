 d' SUP ciamObject STRUCTURAL MUST ( cn $ ciamBackendType $ ciamBaseDn ) X-O
 RIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.17 NAME 'ciamIndex' DESC 'DS backend 
