 UST ( cn $ ciamLdapName $ ciamLdapClassKind ) MAY ( ciamLdapOid $ ciamLdapS
 uperior $ ciamLdapMust $ ciamLdapMay $ ciamPurpose ) X-ORIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.35 NAME 'ciamIdentityService' DESC 'T
