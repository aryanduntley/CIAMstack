 lgorithm $ ciamKeySize $ ciamKeyUsage $ ciamMaterialFormat $ ciamHsmRequire
 d $ ciamExportable $ ciamRotationDays $ ciamContinuityReason $ ciamUsedIn $
  ciamRotationRunbook ) X-ORIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.43 NAME 'ciamCertificateRef' DESC 'A 
 certificate held in a cloud certificate store' SUP ciamBinding STRUCTURAL M
 UST ( ciamRefUri $ ciamHoldsCertificate ) MAY ( ciamAutoRotate $ ciamLastRo
 tated $ ciamReplicaRegion $ ciamKeyUser $ ciamMaterialFrom ) X-ORIGIN 'opsd
 ir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.44 NAME 'ciamRequiredRole' DESC 'A ro
 le the environment must bind, declared as data (beyond what its domains and
  adapters require); the description says why' SUP ciamObject STRUCTURAL MUS
 T ( cn $ ciamBindingRole ) X-ORIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.45 NAME 'ciamOverride' DESC 'An envir
 onment\27s own value for one overridable attribute of a shared entry; the d
