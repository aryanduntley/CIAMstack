objectClasses: ( 2.5.6.0 NAME 'top' DESC 'Top of the class hierarchy' ABSTRA
 CT MUST objectClass X-ORIGIN 'RFC 4519' )
objectClasses: ( 2.5.6.5 NAME 'organizationalUnit' DESC 'Organizational unit
 ' SUP top STRUCTURAL MUST ou MAY description X-ORIGIN 'RFC 4519' )
objectClasses: ( 0.9.2342.19200300.100.4.13 NAME 'domain' DESC 'Domain' SUP 
 top STRUCTURAL MUST dc MAY description X-ORIGIN 'RFC 4519' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.1 NAME 'ciamObject' DESC 'Base of eve
 ry operations-directory entry' SUP top ABSTRACT MAY ( description $ ciamOwn
 er $ ciamLastChanged $ ciamChangeRef ) X-ORIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.2 NAME 'ciamCloud' DESC 'A cloud host
 ing environment' SUP ciamObject STRUCTURAL MUST ( cloud $ ciamCloudProvider
  $ ciamRegion ) MAY ( ciamCloudEnvironment $ ciamLifecycle ) X-ORIGIN 'opsd
 ir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.3 NAME 'ciamEnvironment' DESC 'A depl
 oyment stage within a cloud' SUP ciamObject STRUCTURAL MUST env MAY ( ciamL
 ifecycle $ ciamPlannedCutover $ ciamJoinsDeploymentOf ) X-ORIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.4 NAME 'ciamServer' DESC 'A server in
 stance' SUP ciamObject STRUCTURAL MUST ( cn $ ciamServerRole $ ciamHostname
  $ ciamSubnet ) MAY ( ciamProductVersion $ ciamPrivateIp $ ciamZone $ ciamI
 nstanceSize $ ciamImageRef ) X-ORIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.5 NAME 'ciamBinding' DESC 'Environmen
 t-specific binding of an abstract role' SUP ciamObject ABSTRACT MUST ( cn $
  ciamBindingRole ) MAY ciamProviderRef X-ORIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.6 NAME 'ciamNetwork' DESC 'Network (V
 PC / VNet)' SUP ciamBinding STRUCTURAL MUST ciamCidr MAY ciamResourceGroup 
 X-ORIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.7 NAME 'ciamSubnetBinding' DESC 'Subn
 et' SUP ciamBinding STRUCTURAL MUST ciamCidr MAY ciamZone X-ORIGIN 'opsdir'
  )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.8 NAME 'ciamServiceName' DESC 'Stable
  service name + load balancer' SUP ciamBinding STRUCTURAL MUST ( ciamFqdn $
  ciamTargetRole $ ciamPort ) MAY ( ciamDnsZone $ ciamDnsZoneRef $ ciamFront
 endIp $ ciamTlsCertificate ) X-ORIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.9 NAME 'ciamFirewallRule' DESC 'Inbou
 nd allow rule' SUP ciamBinding STRUCTURAL MUST ( ciamSourceCidr $ ciamPort 
 $ ciamTargetRole ) MAY ( ciamProtocol $ ciamAllowsConsumer $ ciamRulePriori
 ty ) X-ORIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.10 NAME 'ciamSecretRef' DESC 'Referen
 ce to a secret' SUP ciamBinding STRUCTURAL MUST ciamRefUri X-ORIGIN 'opsdir
 ' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.11 NAME 'ciamKeyRef' DESC 'Reference 
 to an encryption key' SUP ciamBinding STRUCTURAL MUST ciamRefUri X-ORIGIN '
 opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.12 NAME 'ciamEgress' DESC 'Outbound (
 NAT) addresses our services send from' SUP ciamBinding STRUCTURAL MUST ciam
 Cidr X-ORIGIN 'opsdir' )
objectClasses: ( 1.3.6.1.4.1.32473.1.2.13 NAME 'ciamExternalAllowlist' DESC 
 'An allowlist in someone else\27s system that contains our addresses' SUP c
 iamObject STRUCTURAL MUST ( cn $ ciamManagedBy $ ciamRefersToRole $ ciamRec
