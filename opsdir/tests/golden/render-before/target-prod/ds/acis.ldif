# ACIs for the user directory. Generated by opsdir from ou=acis,dc=ciam-ops.
# Environment-neutral. Apply with ldapmodify under change control.

dn: ou=people,dc=partners,dc=example-aero,dc=test
changetype: modify
add: aci
aci: (targetattr = "uid || mail || companyId || appEntitlement || registrationStatus || lastLoginTime")(version 3.0; acl "aci-idm-write"; allow (read,search,write) userdn = "ldap:///uid=idm-sync,ou=service-accounts,dc=partners,dc=example-aero,dc=test";)

# WARNING aci-legacy-all: no owner, no justification, targetattr=* (all attributes)
dn: ou=people,dc=partners,dc=example-aero,dc=test
changetype: modify
add: aci
aci: (targetattr = "*")(version 3.0; acl "aci-legacy-all"; allow (read,search) userdn = "ldap:///uid=rptuser,ou=customers,ou=people,dc=partners,dc=example-aero,dc=test";)

dn: ou=people,dc=partners,dc=example-aero,dc=test
changetype: modify
add: aci
aci: (targetattr = "mail || companyId || soldToAccount || exportScreeningStatus || description")(version 3.0; acl "aci-mro-read"; allow (read,search) userdn = "ldap:///uid=mro-export,ou=service-accounts,dc=partners,dc=example-aero,dc=test";)

dn: ou=people,dc=partners,dc=example-aero,dc=test
changetype: modify
add: aci
aci: (targetattr = "uid || mail || givenName || sn || companyId || appEntitlement || registrationStatus")(version 3.0; acl "aci-pf-read"; allow (read,search,compare) userdn = "ldap:///uid=pf-svc,ou=service-accounts,dc=partners,dc=example-aero,dc=test";)

dn: ou=people,dc=partners,dc=example-aero,dc=test
changetype: modify
add: aci
aci: (targetattr = "mail || registrationStatus || telephoneNumber || challengeAnswer")(version 3.0; acl "aci-portal-write"; allow (read,search,write) userdn = "ldap:///uid=portal-svc,ou=service-accounts,dc=partners,dc=example-aero,dc=test";)

dn: ou=people,dc=partners,dc=example-aero,dc=test
changetype: modify
add: aci
aci: (targetattr = "mail || companyId || soldToAccount")(version 3.0; acl "aci-supplier-read"; allow (read,search) userdn = "ldap:///uid=supplier-svc,ou=service-accounts,dc=partners,dc=example-aero,dc=test";)
