[
  {
    "clientId": "mobile-ops",
    "name": "mobile-ops",
    "enabled": true,
    "redirectUris": [
      "https://mobile.example-aero.test/oauth2/callback"
    ],
    "grantTypes": [
      "AUTHORIZATION_CODE",
      "REFRESH_TOKEN"
    ],
    "requireProofKeyForCodeExchange": true,
    "x-opsdir": {
      "claims": {
        "email": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "mail"
        },
        "org": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "companyId"
        },
        "sub": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "uid"
        }
      },
      "mfaRequired": true,
      "owners": [
        "mobile-team"
      ]
    }
  },
  {
    "clientId": "tech-pubs-web",
    "name": "tech-pubs",
    "enabled": true,
    "redirectUris": [
      "https://techpubs.example-aero.test/oidc/callback"
    ],
    "grantTypes": [
      "AUTHORIZATION_CODE",
      "REFRESH_TOKEN"
    ],
    "requireProofKeyForCodeExchange": true,
    "x-opsdir": {
      "claims": {
        "email": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "mail"
        },
        "entitlements": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "appEntitlement"
        },
        "export_status": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "exportScreeningStatus"
        },
        "org": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "companyId"
        }
      },
      "mfaRequired": false,
      "owners": [
        "tech-pubs-team"
      ]
    }
  }
]
