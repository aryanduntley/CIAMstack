# CHG-2005 (approved): name the secrets the imported IDM connectors and PingFederate data stores use. The imports
# withheld their credentials and can't know which secret each environment holds them in; each connector and data
# store now names its secret role, and every environment renders its own reference.
dn: cn=ldap,ou=connectors,ou=pingidm,dc=ciam-ops
changetype: modify
replace: pingidmCredentialRole
pingidmCredentialRole: idm-ds-bind-password
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2005,ou=changes,dc=ciam-ops
-

dn: cn=hrdb,ou=connectors,ou=pingidm,dc=ciam-ops
changetype: modify
replace: pingidmCredentialRole
pingidmCredentialRole: idm-hrdb-password
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2005,ou=changes,dc=ciam-ops
-

dn: cn=user-directory,ou=data-stores,ou=pingfederate,dc=ciam-ops
changetype: modify
replace: pingfedCredentialRole
pingfedCredentialRole: pf-ds-bind-password
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2005,ou=changes,dc=ciam-ops
-

dn: cn=grant-store,ou=data-stores,ou=pingfederate,dc=ciam-ops
changetype: modify
replace: pingfedCredentialRole
pingfedCredentialRole: pf-grants-db-password
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2005,ou=changes,dc=ciam-ops
-
