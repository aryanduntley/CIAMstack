# CHG-2030 (approved): the target's risk acceptance EXC-2026-02 (running without container scanning until PingGateway
# moves) was approved without an expiry, which the planner blocks on: an acceptance nobody can stand behind. The
# authorizing official sets it to 2027-03-31; the plan then shows the scanning action as accepted until then. The
# same CAB approves EXC-2026-03: Defender's IpAnomaly alert on the directory servers is a false positive (the
# replication traffic from the source over the interconnect). azurerm has no resource for Defender's alert suppression
# rules, so the target's cloud allows Microsoft's azapi provider (an add-on), and the suppression renders through it.
dn: cn=EXC-2026-02,ou=exceptions,dc=ciam-ops
changetype: modify
replace: ciamExpiresAt
ciamExpiresAt: 20270331000000Z
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2030,ou=changes,dc=ciam-ops

dn: cloud=target,ou=environments,dc=ciam-ops
changetype: modify
add: ciamProviderAddOn
ciamProviderAddOn: azapi
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2030,ou=changes,dc=ciam-ops

dn: cn=EXC-2026-03,ou=exceptions,dc=ciam-ops
changetype: add
objectClass: top
objectClass: ciamRiskException
cn: EXC-2026-03
ciamExceptionKind: false-positive
ciamExceptionStatus: approved
ciamAffectedEnvironment: env=prod,cloud=target,ou=environments,dc=ciam-ops
ciamFindingRef: azure:alerts:IpAnomaly
ciamJustification: the directory servers' replication traffic from the source over the interconnect
ciamRiskAuthority: cn=authorizing-official,ou=owners,dc=ciam-ops
ciamApprovedBy: CAB 2026-09-18
ciamApprovedAt: 20260918000000Z
ciamExpiresAt: 20270331000000Z
ciamOwner: cn=ciam-platform,ou=owners,dc=ciam-ops
ciamChangeRef: cn=CHG-2030,ou=changes,dc=ciam-ops

dn: cn=exc-EXC-2026-03,ou=bindings,env=prod,cloud=target,ou=environments,dc=ciam-ops
changetype: add
objectClass: top
objectClass: ciamSuppression
cn: exc-EXC-2026-03
ciamBindingRole: suppression-EXC-2026-03
ciamFindingRef: azure:alerts:IpAnomaly
ciamExceptionRef: cn=EXC-2026-03,ou=exceptions,dc=ciam-ops
ciamOwner: cn=ciam-platform,ou=owners,dc=ciam-ops
ciamChangeRef: cn=CHG-2030,ou=changes,dc=ciam-ops
