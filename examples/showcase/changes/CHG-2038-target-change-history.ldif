# CHG-2038 (approved): the decision CHG-2024 left open. The source keeps seven years of its resources' configuration
# history (AWS Config, 2557 days, exported to a bucket); Azure's Resource Graph keeps 14 days. The target keeps the
# same 2557 days by exporting its resource changes every hour into its security workspace (the Logs Ingestion API:
# milestone 5.7b), so nothing older than two weeks is lost after the move.
dn: cn=resource-changes,ou=bindings,env=prod,cloud=target,ou=environments,dc=ciam-ops
changetype: modify
replace: ciamRetentionDays
ciamRetentionDays: 2557
-
add: ciamFindingsRole
ciamFindingsRole: security-findings
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2038,ou=changes,dc=ciam-ops
