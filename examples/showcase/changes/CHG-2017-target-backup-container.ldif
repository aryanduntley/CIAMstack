# CHG-2017 (approved): give the target environment its directory backup target, a container in a storage account the
# stack keeps (versioned, encrypted with the target's disk key, private, the same lifecycle as production), and let
# the directory servers' identity write to it. Copied from the stage template, it has no immutability policy and
# nothing copies it to another region: the planner names both.
dn: cn=backup,ou=bindings,env=prod,cloud=target,ou=environments,dc=ciam-ops
changetype: add
objectClass: top
objectClass: ciamBackupTarget
cn: backup
ciamBindingRole: backup-target
ciamStorageRef: azblob://stciamprodbackups/ds-backups
ciamRetentionDays: 35
ciamStorageVersioning: TRUE
ciamEncryptedByRole: disk-encryption
ciamStoragePublicBlocked: TRUE
ciamStorageLifecycle: 30 cold
ciamStorageLifecycle: 90 delete
ciamStorageLifecycle: noncurrent 7 delete
ciamChangeRef: cn=CHG-2017,ou=changes,dc=ciam-ops

dn: cn=identity-ds,ou=bindings,env=prod,cloud=target,ou=environments,dc=ciam-ops
changetype: modify
add: ciamGrant
ciamGrant: Storage Blob Data Contributor on /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-ciam-prod/providers/Microsoft.Storage/storageAccounts/stciamprodbackups/blobServices/default/containers/ds-backups
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2017,ou=changes,dc=ciam-ops
