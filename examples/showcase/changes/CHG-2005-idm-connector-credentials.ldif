# CHG-2005 (approved): name the secrets the imported IDM connectors use. The import withheld their credentials and
# can't know which secret each environment holds them in; each connector now names its secret role, and every
# environment renders its own reference.
dn: cn=ldap,ou=connectors,ou=pingidm,dc=ciam-ops
changetype: modify
replace: pingidmCredentialRole
pingidmCredentialRole: idm-ds-bind-password
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2005,ou=changes,dc=ciam-ops
-

dn: cn=hrdb,ou=connectors,ou=pingidm,dc=ciam-ops
changetype: modify
replace: pingidmCredentialRole
pingidmCredentialRole: idm-hrdb-password
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2005,ou=changes,dc=ciam-ops
-
