# CHG-2015 (approved): forward the AD domain to the domain controllers from the target environment, as the source
# does by a Route 53 Resolver rule. Without it, nothing in the target resolves corp.example-aero.internal: PingIDM's
# and PingFederate's AD lookups fail at cutover.
dn: cn=fwd-corp-ad,ou=bindings,env=prod,cloud=target,ou=environments,dc=ciam-ops
changetype: add
objectClass: top
objectClass: ciamDnsForwarder
cn: fwd-corp-ad
ciamBindingRole: forwarder-corp.example-aero.internal
ciamForwardDomain: corp.example-aero.internal
ciamForwardTarget: 10.40.0.53
ciamForwardTarget: 10.40.0.54
ciamForwardDirection: outbound
ciamProviderRef: /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-ciam-prod/providers/Microsoft.Network/dnsForwardingRulesets/dfrs-ciam-prod/forwardingRules/corp-ad
ciamChangeRef: cn=CHG-2015,ou=changes,dc=ciam-ops
