# CHG-2069 (approved): record Example Aero Issuing CA 2's certificate itself (public material, from the CA's own
# export: never a key), correcting the fingerprint CHG-2051 typed in from the console. The directory's LDAPS
# certificate (ds-ldaps-2026) chains to it, and no check runtime trusts the corporate root: with the CA certificate
# recorded, the source's directory-bind canary is given it to trust (the intermediate as the anchor: the root's
# certificate itself isn't recorded) instead of being left unrendered. (The standby's check still isn't rendered:
# Google runs no synthetic checks in its Assured Workloads boundary.)
dn: cn=example-aero-issuing-ca-2,ou=certificates,dc=ciam-ops
changetype: modify
replace: ciamFingerprint
ciamFingerprint: 47:9B:50:A4:31:88:5C:31:5F:40:D8:9E:D9:F6:73:53:EE:E6:E5:B2:63:C7:39:F4:DE:4D:3A:14:28:AE:D7:A2
