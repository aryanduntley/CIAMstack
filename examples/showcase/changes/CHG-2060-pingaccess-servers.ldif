changetype: add
objectClass: top
objectClass: ciamServer
cn: pa-admin-1
ciamHostname: pa-admin-1.aws.internal.example-aero.test
ciamImageRef: ami-0d4e5f6a7b8c90456
ciamInstallRoot: /opt/ping/pingaccess
ciamInstanceSize: m6i.large
ciamOwner: cn=ciam-platform,ou=owners,dc=ciam-ops
ciamPrivateIp: 10.20.10.41
ciamProductVersion: PingAccess 8.3.6
ciamServerRole: pa-admin
ciamSubnet: cn=subnet-ig-a,ou=bindings,env=prod,cloud=source,ou=environments,dc=ciam-ops
ciamZone: us-east-1a
ciamChangeRef: cn=CHG-2060,ou=changes,dc=ciam-ops

