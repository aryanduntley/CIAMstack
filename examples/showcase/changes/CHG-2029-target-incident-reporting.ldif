# CHG-2029 (approved): production is held to DFARS 252.204-7012 (report a cyber incident within 72 hours of discovery
# on DIBNet) and GuardDuty pages the incident process on its high and worse findings; the target was set up held to no
# reporting obligation, which the planner blocks on, and Defender for Cloud pages no one. Hold the target to the same
# obligation, give it an incident action group and send Defender's high alerts to it: Defender's alerts are exported to
# the security workspace, and a log alert on its SecurityAlert table pages the action group.
dn: env=prod,cloud=target,ou=environments,dc=ciam-ops
changetype: modify
add: ciamReportingObligationRef
ciamReportingObligationRef: cn=dfars-7012,ou=reporting-obligations,dc=ciam-ops
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2029,ou=changes,dc=ciam-ops

dn: cn=security-incidents,ou=bindings,env=prod,cloud=target,ou=environments,dc=ciam-ops
changetype: add
objectClass: top
objectClass: ciamAlertChannel
cn: security-incidents
ciamBindingRole: security-incidents
ciamChannelKind: action-group
ciamProviderRef: /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-ciam-prod/providers/Microsoft.Insights/actionGroups/ag-ciam-security-incidents
ciamOwner: cn=security-operations,ou=owners,dc=ciam-ops
ciamChangeRef: cn=CHG-2029,ou=changes,dc=ciam-ops

dn: cn=defender,ou=bindings,env=prod,cloud=target,ou=environments,dc=ciam-ops
changetype: modify
replace: ciamIncidentRole
ciamIncidentRole: security-incidents
-
replace: ciamIncidentSeverity
ciamIncidentSeverity: high
-
replace: ciamChangeRef
ciamChangeRef: cn=CHG-2029,ou=changes,dc=ciam-ops
