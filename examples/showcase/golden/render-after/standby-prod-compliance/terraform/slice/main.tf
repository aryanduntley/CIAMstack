# Generated by opsdir from env=prod,cloud=standby,ou=environments,dc=ciam-ops
# Google Cloud infrastructure for the CIAM platform, bindings compliance: a slice rendered on request, applied after the roots it reads
# Do not edit. Change the operations directory (under an approved change) and re-render.

variable "organization_id" {
  type        = string
  description = "The organization the compliance frameworks are deployed in"
  default     = "123456789012"
}

# compliance: Security Command Center (Premium or Enterprise) activated with Security Health Analytics (activation has no Terraform resource and enabling its services only a google-beta one): a request to the organization's administrators (not rendered)

resource "google_cloud_security_compliance_framework_deployment" "compliance_nist_800_53_r5" {
  # nist-800-53-r5: Compliance Manager's NIST SP 800-53 R5, every control (DETECTIVE where it can be, else AUDIT); one deployment per framework (Google's pages say both one and several may be deployed on one resource)
  organization            = var.organization_id
  location                = "global"
  framework_deployment_id = "compliance-nist-800-53-r5"
  description             = "compliance's nist-800-53-r5 assessment (ciam:nist-800-53-r5)"
  framework {
    framework         = "organizations/123456789012/locations/global/frameworks/builtin-nist-800-53-r5"
    major_revision_id = "2"
  }
  target_resource_config {
    existing_target_resource = "projects/${var.project_id}"
  }
  cloud_control_metadata {
    enforcement_mode = "DETECTIVE"
    cloud_control_details {
      name              = "organizations/123456789012/locations/global/cloudControls/builtin-audit-logging-enabled"
      major_revision_id = "1"
    }
  }
  cloud_control_metadata {
    enforcement_mode = "DETECTIVE"
    cloud_control_details {
      name              = "organizations/123456789012/locations/global/cloudControls/builtin-cmek-on-cloud-sql"
      major_revision_id = "2"
    }
  }
  cloud_control_metadata {
    enforcement_mode = "DETECTIVE"
    cloud_control_details {
      name              = "organizations/123456789012/locations/global/cloudControls/builtin-restrict-public-buckets"
      major_revision_id = "1"
    }
  }
  cloud_control_metadata {
    enforcement_mode = "DETECTIVE"
    cloud_control_details {
      name              = "organizations/123456789012/locations/global/cloudControls/builtin-restrict-resource-locations"
      major_revision_id = "1"
      parameters {
        name = "allowedLocations"
        parameter_value {
          string_list_value {
            values = ["in:us-locations"]
          }
        }
      }
    }
  }
}

resource "google_cloud_security_compliance_framework_deployment" "compliance_cis" {
  # cis: Compliance Manager's CIS Google Cloud Computing Platform Benchmark v3.0, every control (DETECTIVE where it can be, else AUDIT); one deployment per framework (Google's pages say both one and several may be deployed on one resource)
  organization            = var.organization_id
  location                = "global"
  framework_deployment_id = "compliance-cis"
  description             = "compliance's cis assessment (ciam:cis)"
  framework {
    framework         = "organizations/123456789012/locations/global/frameworks/builtin-cis-gcp-3-0"
    major_revision_id = "1"
  }
  target_resource_config {
    existing_target_resource = "projects/${var.project_id}"
  }
  cloud_control_metadata {
    enforcement_mode = "DETECTIVE"
    cloud_control_details {
      name              = "organizations/123456789012/locations/global/cloudControls/builtin-audit-logging-enabled"
      major_revision_id = "1"
    }
  }
  cloud_control_metadata {
    enforcement_mode = "DETECTIVE"
    cloud_control_details {
      name              = "organizations/123456789012/locations/global/cloudControls/builtin-os-login-enabled"
      major_revision_id = "1"
    }
  }
  cloud_control_metadata {
    enforcement_mode = "DETECTIVE"
    cloud_control_details {
      name              = "organizations/123456789012/locations/global/cloudControls/builtin-restrict-public-buckets"
      major_revision_id = "1"
    }
  }
}

resource "google_scc_v2_project_notification_config" "compliance_findings" {
  # Security Command Center's service agent must be able to publish to the topic
  config_id    = "compliance-findings"
  project      = var.project_id
  location     = "global"
  description  = "compliance's findings to security-findings"
  pubsub_topic = "projects/example-aero-ciam-standby/topics/ciam-security"
  streaming_config {
    filter = "finding_class=\"MISCONFIGURATION\" AND state=\"ACTIVE\""
  }
}
