resource "azurerm_nat_gateway" "egress_pf" {
  name                = "natgw-ciam-prod"
  location            = data.azurerm_resource_group.main.location
  resource_group_name = data.azurerm_resource_group.main.name
  sku_name            = "Standard"
  tags = {
    Role      = "pf-egress"
    ManagedBy = "opsdir"
  }
}

import {
  to = azurerm_nat_gateway.egress_pf
  id = "${data.azurerm_resource_group.main.id}/providers/Microsoft.Network/natGateways/natgw-ciam-prod"
}

resource "azurerm_nat_gateway_public_ip_association" "egress_pf_0" {
  nat_gateway_id       = azurerm_nat_gateway.egress_pf.id
  public_ip_address_id = var.egress_pf_ip_0
}

import {
  to = azurerm_nat_gateway_public_ip_association.egress_pf_0
  id = "${data.azurerm_resource_group.main.id}/providers/Microsoft.Network/natGateways/natgw-ciam-prod|${var.egress_pf_ip_0}"
}

# egress-pf: the subnets an existing NAT gateway serves aren't recorded; its subnet associations stay as they are

