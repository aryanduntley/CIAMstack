resource "azurerm_firewall_policy_rule_collection_group" "egress_firewall_sites" {
  name               = "ciam-prod-sites"
  firewall_policy_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-hub-net/providers/Microsoft.Network/firewallPolicies/fwp-hub"
  priority           = 500
  application_rule_collection {
    name     = "ciam-prod-sites"
    priority = 500
    action   = "Allow"
    rule {
      name = "sites-80"
      protocols {
        type = "Http"
        port = 80
      }
      source_addresses  = ["10.60.0.0/16"]
      destination_fqdns = ["ocsp.example-ca.test", "crl.example-ca.test"]
    }
    rule {
      name = "sites-443"
      protocols {
        type = "Https"
        port = 443
      }
      source_addresses  = ["10.60.0.0/16"]
      destination_fqdns = ["metadata.skyline-air.test", "sso.harbor-mro.test"]
    }
  }
}
