# Generated by opsdir from env=stage,cloud=source,ou=environments,dc=ciam-ops
# AWS landing zone for the CIAM platform, kept by cloud-landing-zone: applied by the landing zone, not by the platform's pipeline
# Do not edit. Change the operations directory (under an approved change) and re-render.

resource "aws_iam_openid_connect_provider" "token_actions_githubusercontent_com" {
  url            = "https://token.actions.githubusercontent.com"
  client_id_list = ["sts.amazonaws.com"]
}

resource "aws_iam_role" "identity_ci" {
  name = "ciam-prod-deploy"
  assume_role_policy = jsonencode({
    "Version" : "2012-10-17",
    "Statement" : [
      {
        "Effect" : "Allow",
        "Action" : "sts:AssumeRoleWithWebIdentity",
        "Principal" : {
          "Federated" : "${aws_iam_openid_connect_provider.token_actions_githubusercontent_com.arn}"
        },
        "Condition" : {
          "StringEquals" : {
            "token.actions.githubusercontent.com:aud" : "sts.amazonaws.com"
          },
          "StringLike" : {
            "token.actions.githubusercontent.com:sub" : "repo:example-aero/ciam-ops:environment:prod"
          }
        }
      }
    ]
  })
  tags = {
    Principal = "ciam-ops-ci"
    Role      = "identity-ci"
    ManagedBy = "opsdir"
  }
}

resource "aws_iam_role_policy" "identity_ci" {
  name = "ciam-prod-deploy-permissions"
  role = aws_iam_role.identity_ci.id
  policy = jsonencode({
    "Version" : "2012-10-17",
    "Statement" : [
      {
        "Sid" : "ManagePfSsoService",
        "Effect" : "Allow",
        "Action" : [
          "elasticloadbalancing:ModifyListener",
          "elasticloadbalancing:RegisterTargets",
          "elasticloadbalancing:DeregisterTargets",
          "route53:ChangeResourceRecordSets"
        ],
        "Resource" : [
          "arn:aws:elasticloadbalancing:*:*:loadbalancer/net/ciam-stage-svc-sso/*",
          "arn:aws:elasticloadbalancing:*:*:listener/net/ciam-stage-svc-sso/*",
          "arn:aws:elasticloadbalancing:*:*:targetgroup/ciam-stage-svc-sso-*",
          "arn:aws:route53:::hostedzone/Z0EXAMPLE2PUBLIC"
        ]
      },
      {
        "Sid" : "WriteSecretPfAdminPassword",
        "Effect" : "Allow",
        "Action" : [
          "secretsmanager:PutSecretValue"
        ],
        "Resource" : [
          "arn:aws:secretsmanager:us-east-1:111122223333:secret:ciam/stage/pf-admin-password-??????"
        ]
      }
    ]
  })
}

data "aws_ssoadmin_instances" "sso" {
}

resource "aws_ssoadmin_permission_set" "identity_admins" {
  name             = "ciam-stage-ciam-admins"
  instance_arn     = tolist(data.aws_ssoadmin_instances.sso.arns)[0]
  session_duration = "PT4H"
  description      = "ciam-admins (identity-admins)"
}

resource "aws_ssoadmin_permission_set_inline_policy" "identity_admins" {
  instance_arn       = tolist(data.aws_ssoadmin_instances.sso.arns)[0]
  permission_set_arn = aws_ssoadmin_permission_set.identity_admins.arn
  inline_policy = jsonencode({
    "Version" : "2012-10-17",
    "Statement" : [
      {
        "Sid" : "ManagePfAdminPassword",
        "Effect" : "Allow",
        "Action" : [
          "secretsmanager:PutSecretValue",
          "secretsmanager:UpdateSecret",
          "secretsmanager:RotateSecret",
          "secretsmanager:DeleteSecret"
        ],
        "Resource" : [
          "arn:aws:secretsmanager:us-east-1:111122223333:secret:ciam/stage/pf-admin-password-??????"
        ]
      },
      {
        "Sid" : "ManageKeyDiskEncryption",
        "Effect" : "Allow",
        "Action" : [
          "kms:DescribeKey",
          "kms:EnableKeyRotation",
          "kms:PutKeyPolicy"
        ],
        "Resource" : [
          "arn:aws:kms:us-east-1:111122223333:key/mrk-1234abcd12ab34cd56ef1234567890ab"
        ]
      },
      {
        "Sid" : "ReadLogsAuditLogs",
        "Effect" : "Allow",
        "Action" : [
          "logs:GetLogEvents",
          "logs:FilterLogEvents"
        ],
        "Resource" : [
          "arn:aws:logs:us-east-1:111122223333:log-group:/ciam/prod/audit:*",
          "arn:aws:logs:us-east-1:111122223333:log-group:/ciam/prod/audit"
        ]
      }
    ]
  })
}

resource "aws_ssoadmin_account_assignment" "identity_admins" {
  instance_arn       = tolist(data.aws_ssoadmin_instances.sso.arns)[0]
  permission_set_arn = aws_ssoadmin_permission_set.identity_admins.arn
  principal_id       = "9a4f7c2e-0000-4000-8000-0000000000a1"
  principal_type     = "GROUP"
  target_id          = var.account_id
  target_type        = "AWS_ACCOUNT"
}

resource "aws_organizations_policy" "org_guardrails" {
  name        = "ciam-stage-org-guardrails"
  type        = "SERVICE_CONTROL_POLICY"
  description = "Prevents region-escape, audit-log-disable, key-deletion (source/stage)"
  content = jsonencode({
    "Version" : "2012-10-17",
    "Statement" : [
      {
        "Effect" : "Deny",
        "Resource" : "*",
        "Sid" : "DenyOutsideRegion",
        "NotAction" : [
          "a4b:*",
          "acm:*",
          "aws-marketplace-management:*",
          "aws-marketplace:*",
          "aws-portal:*",
          "budgets:*",
          "ce:*",
          "chime:*",
          "cloudfront:*",
          "config:*",
          "cur:*",
          "directconnect:*",
          "ec2:DescribeRegions",
          "ec2:DescribeTransitGateways",
          "ec2:DescribeVpnGateways",
          "fms:*",
          "globalaccelerator:*",
          "health:*",
          "iam:*",
          "importexport:*",
          "kms:*",
          "mobileanalytics:*",
          "networkmanager:*",
          "organizations:*",
          "pricing:*",
          "route53:*",
          "route53domains:*",
          "route53-recovery-cluster:*",
          "route53-recovery-control-config:*",
          "route53-recovery-readiness:*",
          "s3:GetAccountPublic*",
          "s3:ListAllMyBuckets",
          "s3:ListMultiRegionAccessPoints",
          "s3:PutAccountPublic*",
          "shield:*",
          "sts:*",
          "support:*",
          "trustedadvisor:*",
          "waf-regional:*",
          "waf:*",
          "wafv2:*",
          "wellarchitected:*"
        ],
        "Condition" : {
          "StringNotEquals" : {
            "aws:RequestedRegion" : [
              "us-east-1"
            ]
          }
        }
      },
      {
        "Effect" : "Deny",
        "Resource" : "*",
        "Sid" : "DenyCloudTrailChanges",
        "Action" : [
          "cloudtrail:DeleteTrail",
          "cloudtrail:PutEventSelectors",
          "cloudtrail:StopLogging",
          "cloudtrail:UpdateTrail"
        ]
      },
      {
        "Effect" : "Deny",
        "Resource" : "*",
        "Sid" : "DenyKeyDeletion",
        "Action" : [
          "kms:ScheduleKeyDeletion",
          "kms:DeleteAlias",
          "kms:DeleteCustomKeyStore",
          "kms:DeleteImportedKeyMaterial"
        ]
      }
    ]
  })
}

resource "aws_organizations_policy_attachment" "org_guardrails" {
  policy_id = aws_organizations_policy.org_guardrails.id
  target_id = var.guardrail_target_id
}
