[
  {
    "clientId": "mobile-ops",
    "name": "mobile-ops",
    "enabled": true,
    "redirectUris": [
      "https://mobile.example-aero.test/oauth2/callback"
    ],
    "grantTypes": [
      "AUTHORIZATION_CODE",
      "REFRESH_TOKEN"
    ],
    "requireProofKeyForCodeExchange": true,
    "clientAuth": {
      "type": "NONE"
    },
    "restrictScopes": true,
    "restrictedScopes": [
      "openid",
      "email",
      "offline_access"
    ],
    "x-opsdir": {
      "claims": {
        "email": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "mail"
        },
        "org": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "companyId"
        },
        "sub": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "uid"
        }
      },
      "mfaRequired": true,
      "owners": [
        "mobile-team"
      ]
    }
  },
  {
    "clientId": "reports-api",
    "name": "reports-api",
    "enabled": true,
    "redirectUris": [],
    "grantTypes": [
      "CLIENT_CREDENTIALS"
    ],
    "requireProofKeyForCodeExchange": false,
    "clientAuth": {
      "type": "SECRET"
    },
    "restrictScopes": true,
    "restrictedScopes": [
      "reports.read"
    ],
    "x-opsdir": {
      "claims": {},
      "mfaRequired": false,
      "owners": []
    }
  },
  {
    "clientId": "tech-pubs-web",
    "name": "tech-pubs",
    "enabled": true,
    "redirectUris": [
      "https://techpubs.example-aero.test/oidc/callback"
    ],
    "grantTypes": [
      "AUTHORIZATION_CODE",
      "REFRESH_TOKEN"
    ],
    "requireProofKeyForCodeExchange": true,
    "clientAuth": {
      "type": "NONE"
    },
    "restrictScopes": true,
    "restrictedScopes": [
      "openid",
      "profile",
      "email"
    ],
    "x-opsdir": {
      "claims": {
        "email": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "mail"
        },
        "entitlements": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "appEntitlement"
        },
        "export_status": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "exportScreeningStatus"
        },
        "org": {
          "source": {
            "type": "LDAP_DATA_STORE",
            "id": "ciam-user-directory"
          },
          "value": "companyId"
        }
      },
      "mfaRequired": false,
      "owners": [
        "tech-pubs-team"
      ]
    }
  }
]
