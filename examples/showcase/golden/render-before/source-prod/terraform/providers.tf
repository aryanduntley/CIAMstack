# Generated by opsdir from env=prod,cloud=source,ou=environments,dc=ciam-ops
# Providers
# Do not edit. Change the operations directory (under an approved change) and re-render.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.0"
    }
  }
}

provider "aws" {
  region              = "us-east-1"
  allowed_account_ids = ["111122223333"]
  default_tags {
    tags = {
      CostCenter         = "CC-1001"
      DataClassification = "confidential"
      Environment        = "source/prod"
      Owner              = "ciam-platform"
    }
  }
}

provider "aws" {
  # Copies of databases' automated backups in us-west-2
  alias               = "copy_us_west_2"
  region              = "us-west-2"
  allowed_account_ids = ["111122223333"]
  default_tags {
    tags = {
      CostCenter         = "CC-1001"
      DataClassification = "confidential"
      Environment        = "source/prod"
      Owner              = "ciam-platform"
    }
  }
}

variable "resolver_endpoint_id" {
  description = "The landing zone's outbound Route 53 Resolver endpoint the forwarding rules use"
  type        = string
}
