# dsconfig batch file. Generated by opsdir from ou=declared,ou=config,dc=ciam-ops
# Environment-neutral: the same file is applied to every environment.
# Apply: dsconfig --hostname <ds> --port 4444 --bindDN uid=admin --bindPasswordFile <file> \
#          --usePkcs12TrustStore <truststore> --batchFilePath dsconfig.batch --no-prompt

# backend userData (dc=partners,dc=example-aero,dc=test)
create-backend-index --backend-name userData --index-name appEntitlement --set index-type:equality
create-backend-index --backend-name userData --index-name companyId --set index-type:equality
create-backend-index --backend-name userData --index-name lastLoginTime --set index-type:ordering
create-backend-index --backend-name userData --index-name mail --set index-type:equality
create-backend-index --backend-name userData --index-name registrationStatus --set index-type:equality
create-backend-index --backend-name userData --index-name soldToAccount --set index-type:equality
create-backend-index --backend-name userData --index-name uid --set index-type:equality --set index-type:presence

set-password-policy-prop --policy-name "Default Password Policy" --set default-password-storage-scheme:PBKDF2-HMAC-SHA256 --set password-attribute:userPassword
set-password-policy-prop --policy-name "Root Password Policy" --set default-password-storage-scheme:PBKDF2-HMAC-SHA256 --set password-attribute:userPassword
create-password-policy --policy-name "customers" --type password-policy --set default-password-storage-scheme:PBKDF2-HMAC-SHA256 --set password-attribute:userPassword --set lockout-failure-count:5 --set lockout-duration:"15 m" --set password-history-count:5
create-password-policy --policy-name "service-accounts" --type password-policy --set default-password-storage-scheme:PBKDF2-HMAC-SHA512 --set password-attribute:userPassword --set lockout-failure-count:0 --set password-history-count:0
create-password-policy --policy-name "suppliers" --type password-policy --set default-password-storage-scheme:PBKDF2-HMAC-SHA256 --set password-attribute:userPassword --set lockout-failure-count:5 --set lockout-duration:"15 m" --set password-history-count:8 --set max-password-age:"365 d"

set-connection-handler-prop --handler-name HTTPS --set enabled:true --set listen-port:8443
set-connection-handler-prop --handler-name LDAP --set enabled:false --set listen-port:1389
set-connection-handler-prop --handler-name LDAPS --set enabled:true --set listen-port:1636
set-connection-handler-prop --handler-name LDIF --set enabled:false
set-log-publisher-prop --publisher-name "File-Based Debug Logger" --set enabled:false
set-log-publisher-prop --publisher-name "File-Based Error Logger" --set enabled:true
set-log-publisher-prop --publisher-name "Json File-Based Access Logger" --set enabled:true
set-synchronization-provider-prop --provider-name "Multimaster Synchronization" --set replication-purge-delay:"3 d"
