# Generated by opsdir from env=prod,cloud=standby,ou=environments,dc=ciam-ops
# Google Cloud network kept by cloud-landing-zone for the CIAM platform: applied by them, not by the platform's pipeline
# Do not edit. Change the operations directory (under an approved change) and re-render.

data "google_compute_network" "main" {
  name    = "ciam-standby"
  project = "example-aero-net"
}

data "google_compute_subnetwork" "subnet_am" {
  name    = "ciam-standby-am"
  region  = "us-central1"
  project = "example-aero-net"
}

data "google_compute_subnetwork" "subnet_ds" {
  name    = "ciam-standby-ds"
  region  = "us-central1"
  project = "example-aero-net"
}

data "google_compute_subnetwork" "subnet_edge" {
  name    = "ciam-standby-proxy"
  region  = "us-central1"
  project = "example-aero-net"
}

data "google_compute_subnetwork" "subnet_idm" {
  name    = "ciam-standby-idm"
  region  = "us-central1"
  project = "example-aero-net"
}

data "google_compute_subnetwork" "subnet_ig" {
  name    = "ciam-standby-ig"
  region  = "us-central1"
  project = "example-aero-net"
}

data "google_compute_subnetwork" "subnet_pf" {
  name    = "ciam-standby-pf"
  region  = "us-central1"
  project = "example-aero-net"
}

data "google_compute_addresses" "egress_pf_0" {
  project = "example-aero-ciam-standby"
  region  = "us-central1"
  filter  = "address:203.0.113.150"
}

resource "google_compute_router" "egress_pf" {
  name    = "ciam-standby-router"
  project = "example-aero-ciam-standby"
  region  = "us-central1"
  network = data.google_compute_network.main.self_link
}

import {
  to = google_compute_router.egress_pf
  id = "example-aero-ciam-standby/us-central1/ciam-standby-router"
}

resource "google_compute_router_nat" "egress_pf" {
  name                               = "ciam-standby-nat"
  router                             = google_compute_router.egress_pf.name
  project                            = "example-aero-ciam-standby"
  region                             = "us-central1"
  nat_ip_allocate_option             = "MANUAL_ONLY"
  nat_ips                            = [data.google_compute_addresses.egress_pf_0.addresses[0].self_link]
  source_subnetwork_ip_ranges_to_nat = "LIST_OF_SUBNETWORKS"
  subnetwork {
    name                    = data.google_compute_subnetwork.subnet_am.self_link
    source_ip_ranges_to_nat = ["ALL_IP_RANGES"]
  }
  subnetwork {
    name                    = data.google_compute_subnetwork.subnet_ds.self_link
    source_ip_ranges_to_nat = ["ALL_IP_RANGES"]
  }
  subnetwork {
    name                    = data.google_compute_subnetwork.subnet_edge.self_link
    source_ip_ranges_to_nat = ["ALL_IP_RANGES"]
  }
  subnetwork {
    name                    = data.google_compute_subnetwork.subnet_idm.self_link
    source_ip_ranges_to_nat = ["ALL_IP_RANGES"]
  }
  subnetwork {
    name                    = data.google_compute_subnetwork.subnet_ig.self_link
    source_ip_ranges_to_nat = ["ALL_IP_RANGES"]
  }
  subnetwork {
    name                    = data.google_compute_subnetwork.subnet_pf.self_link
    source_ip_ranges_to_nat = ["ALL_IP_RANGES"]
  }
  # the subnetworks an existing NAT serves aren't recorded: they stay as they are
  lifecycle {
    ignore_changes = [source_subnetwork_ip_ranges_to_nat, subnetwork]
  }
}

import {
  to = google_compute_router_nat.egress_pf
  id = "example-aero-ciam-standby/us-central1/ciam-standby-router/ciam-standby-nat"
}

