resource "google_compute_instance" "am_1" {
  name         = "am-1"
  machine_type = "n2-standard-2"
  zone         = "us-central1-a"
  hostname     = "am-1.gcp.internal.example-aero.test"
  tags         = ["ciam-prod-am"]
  boot_disk {
    initialize_params {
      image = "projects/example-aero-images/global/images/pingam-7-5-1-rhel9"
    }
    kms_key_self_link = "projects/example-aero-ciam-standby/locations/us-central1/keyRings/ciam/cryptoKeys/disk"
  }
  network_interface {
    subnetwork = data.google_compute_subnetwork.subnet_am.self_link
    network_ip = "10.70.3.21"
