resource "google_compute_forwarding_rule" "svc_sso" {
  name                  = "ciam-prod-svc-sso"
  region                = var.region
  load_balancing_scheme = "EXTERNAL_MANAGED"
  ip_protocol           = "TCP"
  port_range            = "443"
