resource "google_compute_region_health_check" "svc_apps" {
  name   = "ciam-prod-svc-apps"
  region = var.region
  tcp_health_check {
    port = 443
  }
}

resource "google_compute_firewall" "svc_apps_health_checks" {
  name        = "ciam-prod-svc-apps-health-checks"
  description = "Google Cloud health checks for svc-apps"
  network     = data.google_compute_network.main.self_link
  direction   = "INGRESS"
  allow {
    protocol = "tcp"
    ports    = ["443"]
  }
  source_ranges = ["35.191.0.0/16", "209.85.152.0/22", "209.85.204.0/22"]
  target_tags   = ["ciam-prod-ig"]
}

resource "google_compute_region_backend_service" "svc_apps" {
  name                  = "ciam-prod-svc-apps"
  region                = var.region
  load_balancing_scheme = "EXTERNAL"
  protocol              = "TCP"
  port_name             = "ciam"
  health_checks         = [google_compute_region_health_check.svc_apps.id]
  backend {
    group           = google_compute_instance_group.svc_apps_us_central1_a.self_link
    balancing_mode  = "CONNECTION"
    capacity_scaler = 1.0
  }
}

