  network               = data.google_compute_network.main.self_link
  network_tier          = "STANDARD"
  target                = google_compute_region_target_https_proxy.svc_sso.id
  labels = {
    service    = "sso-example-aero-test"
    managed_by = "opsdir"
  }
}

