    enable-oslogin = "TRUE"
    ciam-role      = "am"
    ciam-product   = "PingAM 7.5.1"
  }
  labels = {
    role       = "am"
    product    = "pingam-7-5-1"
    managed_by = "opsdir"
  }
}

