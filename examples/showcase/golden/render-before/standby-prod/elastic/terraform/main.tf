# Generated by opsdir from env=prod,cloud=standby,ou=environments,dc=ciam-ops
# Elastic data streams' lifecycle, detection rules and Fleet policies
# Do not edit. Change the operations directory (under an approved change) and re-render.
# NOTE: Elastic rule actions: the detections' rules raise alerts, but who they notify (their actions and connectors) is set in Kibana, not rendered
# NOTE: Elastic data stream logs-ciam.security-standby: opsdir-logs-ciam.security-standby is attached through the component template logs-ciam.security@custom, which takes effect for the backing indices created from the next rollover, and only where the stream's index template composes it (Fleet integration templates do; the built-in logs template doesn't)
# NOTE: Elastic Agent on role pf-engine: its servers' log files reach the Elastic data streams through the Fleet agent policy opsdir-standby-prod-pf-engine (rendered); enrolling the servers is the Elastic team's, and the Fleet Server URL and the policy's enrollment token are Fleet's, never rendered
# NOTE: Elastic Agent on role pf-admin: its servers' log files reach the Elastic data streams through the Fleet agent policy opsdir-standby-prod-pf-admin (rendered); enrolling the servers is the Elastic team's, and the Fleet Server URL and the policy's enrollment token are Fleet's, never rendered

resource "elasticstack_elasticsearch_index_lifecycle" "opsdir_logs_ciam_security_standby" {
  name = "opsdir-logs-ciam.security-standby"
  metadata = jsonencode({
    managed_by  = "opsdir"
    data_stream = "logs-ciam.security-standby"
  })
  hot {
    min_age = "0ms"
    rollover {
      max_age                = "1d"
      max_primary_shard_size = "50gb"
    }
  }
  delete {
    min_age = "90d"
    wait_for_snapshot {
      policy = "opsdir-logs-ciam.security-standby"
    }
    delete {
      delete_searchable_snapshot = true
    }
  }
}

resource "elasticstack_elasticsearch_component_template" "logs_ciam_security_custom" {
  name = "logs-ciam.security@custom"
  metadata = jsonencode({
    managed_by = "opsdir"
  })
  template {
    settings = jsonencode({
      index = {
        lifecycle = {
          name = "opsdir-logs-ciam.security-standby"
        }
      }
    })
  }
}

resource "elasticstack_elasticsearch_snapshot_lifecycle" "opsdir_logs_ciam_security_standby" {
  name                 = "opsdir-logs-ciam.security-standby"
  repository           = "found-snapshots"
  schedule             = "0 30 1 * * ?"
  snapshot_name        = "<opsdir-logs-ciam.security-standby-{now/d}>"
  indices              = ["logs-ciam.security-standby"]
  include_global_state = false
  expire_after         = "275d"
}

resource "elasticstack_kibana_security_detection_rule" "pf_admin_login_failures" {
  rule_id     = "ciam-admin-login-failures"
  name        = "admin-login-failures"
  description = "opsdir: realizes alert rule admin-login-failures"
  type        = "esql"
  language    = "esql"
  query       = "FROM logs-ciam.security-standby | WHERE event.category == \"authentication\" AND event.outcome == \"failure\" AND service.name == \"pf-admin\" | STATS events = COUNT(*) BY slot = BUCKET(@timestamp, 60 seconds) | WHERE events > 10 | STATS breaching = COUNT(*) | WHERE breaching >= 5"
  interval    = "5m"
  from        = "now-5m"
  to          = "now"
  severity    = "medium"
  risk_score  = 47
  enabled     = true
  tags        = ["opsdir"]
}

