    filestream-filestream = {
      enabled = true
      streams = {
        "filestream.filestream" = {
          enabled = true
          vars = jsonencode({
            paths                 = ["/opt/ping/pingfederate-13.1.3/pingfederate/log/audit.log"]
            "data_stream.dataset" = "ciam.security"
