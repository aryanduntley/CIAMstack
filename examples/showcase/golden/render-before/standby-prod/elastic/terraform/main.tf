  name                = "opsdir-standby-prod-pf-engine-pingfederate-log-audit-log"
  namespace           = "standby"
  description         = "opsdir: pingfederate/log/audit.log on role pf-engine into logs-ciam.security-standby (log route security-events)"
  agent_policy_id     = elasticstack_fleet_agent_policy.opsdir_standby_prod_pf_engine.policy_id
  integration_name    = elasticstack_fleet_integration.filestream.name
  integration_version = elasticstack_fleet_integration.filestream.version
