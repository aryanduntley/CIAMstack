{
  "opsdir-logs-ciam.security-standby": {
    "policy": {
      "phases": {
        "hot": {
          "min_age": "0ms",
          "actions": {
            "rollover": {
              "max_age": "1d",
              "max_primary_shard_size": "50gb"
            }
          }
        },
        "delete": {
          "min_age": "90d",
          "actions": {
            "wait_for_snapshot": {
              "policy": "opsdir-logs-ciam.security-standby"
            },
            "delete": {
              "delete_searchable_snapshot": true
            }
          }
        }
      },
      "_meta": {
        "managed_by": "opsdir",
        "data_stream": "logs-ciam.security-standby"
      }
    }
  }
}
