                      "type": "LDAP_DATA_STORE",
                      "id": "user-directory"
                    },
                    "value": "companyId"
                  },
                  "email": {
                    "source": {
                      "type": "LDAP_DATA_STORE",
                      "id": "user-directory"
                    },
                    "value": "mail"
                  }
                },
                "idpAdapterRef": {
                  "id": "htmlform"
                }
              }
            ],
            "assertionLifetime": {
              "minutesBefore": 5,
              "minutesAfter": 5
            }
