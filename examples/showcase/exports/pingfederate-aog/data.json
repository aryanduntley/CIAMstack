            "ssoServiceEndpoints": [
              {
                "binding": "POST",
                "url": "https://parts.aog-exchange.test/saml/acs",
                "isDefault": true
              }
            ],
            "attributeContract": {
              "coreAttributes": [
                {
                  "name": "SAML_SUBJECT"
                }
              ],
              "extendedAttributes": [
                {
                  "name": "company"
                },
                {
                  "name": "email"
                }
              ]
            },
            "adapterMappings": [
              {
                "attributeContractFulfillment": {
