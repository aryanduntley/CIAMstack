        "file": "opsdir/opsdir/domains/automation/pipelines.py",
        "id_in_name": 0,
        "name": "pipeline_groups",
        "parameters": "[{\"name\": \"d\", \"type\": \"Directory\", \"required\": true}, {\"name\": \"pipelines\", \"type\": \"Sequence[FoundPipeline]\", \"required\": true}, {\"name\": \"read\", \"type\": \"Sequence[ReadRepository]\", \"description\": \"the repositories the import read; () removes nothing\", \"required\": false}]",
        "purpose": "Importer groups and removal notices for one CI import, shared by every CI package. Each found pipeline is placed once with a unique name: (DN, (entry,)). Each gone_pipelines entry of the read repositories (same CI system, a repository read, not found again, not at an unread path) becomes an empty group (DN, ()) with a notice naming it, so the import's deletion is the operator's conflict to take or keep.",
        "returns": "{\"type\": \"tuple[tuple, tuple[str]]\", \"description\": \"(groups, notices naming the removed pipelines)\"}",
        "source_hash": "d9add2fa9de91e35"
