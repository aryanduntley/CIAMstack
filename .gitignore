# CIAMstack — the one .gitignore for the whole repository.

# ------------------------------------------------------------------ local dev notes
# docs/ holds personal working notes and is never committed; project documentation
# lives in documentation/ (root) and opsdir/ (README.md, SPEC.md).
docs/

# ------------------------------------------------------------------ AIMFP / agent tooling
# project.db and ProjectBlueprint.md ARE tracked; everything else is per-machine state.
.aimfp-project/user_preferences.db
.aimfp-project/user_directives.db
.aimfp-project/backups/
.aimfp-project/logs/
.aimfp-project/temp/
.aimfp-project/watchdog/
.aimfp-project/.mcp-session-*
.intercomm-aimfp/
.claude/settings.local.json
.claude/worktrees/

# ------------------------------------------------------------------ opsdir runtime state and output
opsdir/.venv/
out/

# ------------------------------------------------------------------ Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.ipynb_checkpoints/

# ------------------------------------------------------------------ Terraform (when validating rendered output)
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# ------------------------------------------------------------------ databases and logs
*.db-wal
*.db-shm
*.db-journal
*.log

# ------------------------------------------------------------------ secrets (never stored; only referenced)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ------------------------------------------------------------------ editors and OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
