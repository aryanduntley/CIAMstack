{
  "name": "portal",
  "baseURI": "https://portal-backend.example.test:8443",
  "condition": "${find(request.uri.host, '^portal.example.test')}",
  "heap": [
    {
      "name": "SystemAndEnvSecretStore-1",
      "type": "SystemAndEnvSecretStore"
    }
  ],
  "handler": {
    "type": "Chain",
    "config": {
      "filters": [
        {
          "name": "OAuth2ClientFilter-1",
          "type": "AuthorizationCodeOAuth2ClientFilter",
          "config": {
            "clientEndpoint": "/home/id_token",
            "failureHandler": {
              "type": "StaticResponseHandler",
              "config": {
                "status": 500
              }
            },
            "registrations": [
              {
                "name": "portal-registration",
                "type": "ClientRegistration",
                "config": {
                  "clientId": "portal-web",
                  "clientSecretId": "oidc.portal.secret",
                  "issuer": {
                    "name": "Issuer",
                    "type": "Issuer",
                    "config": {
                      "wellKnownEndpoint": "https://login.example.test/am/oauth2/.well-known/openid-configuration"
                    }
                  },
                  "scopes": [
                    "openid",
                    "profile",
                    "email"
                  ],
                  "secretsProvider": "SystemAndEnvSecretStore-1",
                  "tokenEndpointAuthMethod": "client_secret_basic"
                }
              }
            ],
            "requireHttps": false
          }
        }
      ],
      "handler": "ReverseProxyHandler"
    }
  }
}
